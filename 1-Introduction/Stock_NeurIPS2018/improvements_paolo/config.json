{
  "data": {
    "ticker_list": [
      "AAPL", "AMGN", "AXP", "BA", "CAT", "CRM", "CSCO", "CVX", "DIS", "DOW",
      "GS", "HD", "HON", "IBM", "INTC", "JNJ", "JPM", "KO", "MCD", "MMM",
      "MRK", "MSFT", "NKE", "PG", "TRV", "UNH", "V", "VZ", "WBA", "WMT"
    ],
    "train_start_date": "2009-01-01",
    "train_end_date":   "2020-07-01",
    "trade_start_date": "2020-07-01",
    "trade_end_date":   "2021-10-29",
    "indicators": [
      "macd", "boll_ub", "boll_lb",
      "rsi_30", "cci_30", "dx_30",
      "close_30_sma", "close_60_sma"
    ],
    "use_turbulence": true,
    "use_vix": true
  },

  "env": {
    "hmax": 100,
    "initial_amount": 1000000,
    "buy_cost_pct":  0.001,
    "sell_cost_pct": 0.001,
    "reward_scaling": 1e-4,
    "turbulence_threshold_train": null,
    "turbulence_threshold_trade": 70,
    "risk_indicator_col": "vix"
  },

  "normalization": {
    "normalize_observations": false,
    "normalize_reward":       false,
    "clip_obs": 10.0
  },

  "models": {
    "a2c": {
      "use": false,
      "total_timesteps": 50000,
      "model_kwargs": {
        "n_steps": 5,
        "ent_coef": 0.01,
        "learning_rate": 0.0007
      },
      "policy_kwargs": {
        "net_arch":      {"pi": [64, 64], "vf": [64, 64]},
        "activation_fn": "Tanh"
      }
    },
    "ppo": {
      "use": true,
      "total_timesteps": 50000,
      "model_kwargs": {
        "n_steps": 2048,
        "ent_coef": 0.01,
        "learning_rate": 0.00025,
        "batch_size": 64
      },
      "policy_kwargs": {
        "net_arch":      {"pi": [64, 64], "vf": [64, 64]},
        "activation_fn": "Tanh"
      }
    },
    "ddpg": {
      "use": false,
      "total_timesteps": 50000,
      "model_kwargs": {
        "batch_size": 128,
        "buffer_size": 100000,
        "learning_rate": 0.001
      },
      "policy_kwargs": {
        "net_arch":      [400, 300],
        "activation_fn": "ReLU"
      }
    },
    "td3": {
      "use": false,
      "total_timesteps": 50000,
      "model_kwargs": {
        "batch_size": 100,
        "buffer_size": 100000,
        "learning_rate": 0.001
      },
      "policy_kwargs": {
        "net_arch":      [400, 300],
        "activation_fn": "ReLU"
      }
    },
    "sac": {
      "use": false,
      "total_timesteps": 50000,
      "model_kwargs": {
        "batch_size": 64,
        "buffer_size": 100000,
        "learning_rate": 0.0001,
        "learning_starts": 100,
        "ent_coef": "auto_0.1"
      },
      "policy_kwargs": {
        "net_arch":      [256, 256],
        "activation_fn": "ReLU"
      }
    }
  },

  "training": {
    "seed": 42
  },

  "paths": {
    "data_dir":        "data",
    "model_dir":       "models",
    "results_dir":     "results",
    "tensorboard_dir": "tensorboard"
  }
}
